# Onyx Utility Core environment example
# Copy to .env and fill in values:  cp .env.example .env

# ------------------------------------------------------------------
# Identity & access
# ------------------------------------------------------------------

# Owner phone(s), country code, no +. Required for auto system log group.
# Handover: OWNER = operator tier (your friend's numbers). Replace later.
OWNER_NUMBER=491753793568

# Creator (host) numbers — tier above owner, comma-separated.
CREATOR_NUMBERS=491753793568

# Extra privileged numbers (comma-separated)
# SUDO=0

# Bot display name + command prefix (changeable at runtime via #config set)
BOT_NAME=ONYX UTILITY CORE
# BOT_PREFIX=#

# First-boot seeds only (runtime #mode / #lang win after)
BOT_MODE=public
BOT_LANG=en   # en | de

# ------------------------------------------------------------------
# Database & login
# ------------------------------------------------------------------

# SQLite path (default) or Postgres URL
# DATABASE_URL=./database.db
# DATABASE_URL=postgresql://user:pass@host:5432/onyxcore

# Pairing-code login instead of QR (digits, country code)
# PAIRING_NUMBER=491753793568

# Process manager identity (used for pm2 stop on core panic / shutdown)
# PM2_APP_NAME=onyx-utility-core

# ------------------------------------------------------------------
# Stickers & media tools
# ------------------------------------------------------------------

STICKER_PACKNAME=Onyx
STICKER_AUTHOR=Onyx

# Optional remove.bg API key for #removebg
# REMOVEBG_API_KEY=

# Temporal media cache for the dashboard message log (RAM-only, wiped on boot)
# MEDIA_MAX_MB=25      # max file size per cached item
# MEDIA_TOTAL_MB=256   # total byte budget
# CHAT_INDEX_MAX=250   # Remote-picker MRU chat list size
# CHAT_INDEX_RETENTION=10 # days to keep chat index entries

# ------------------------------------------------------------------
# AI (LM Studio primary + Groq fallback)
# ------------------------------------------------------------------

# LM Studio - model name only, everything else configured in LM Studio inference UI
LM_STUDIO_MODEL=local-model

# Groq API - automatic fallback when LM Studio is unreachable
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------
# Ops HTTP / dev console
# ------------------------------------------------------------------

# Optional ops HTTP (requires TOKEN if PORT is set)
# ADMIN_HTTP_PORT=8787
# ADMIN_HTTP_HOST=127.0.0.1
# ADMIN_HTTP_TOKEN=change-me-to-a-long-secret
# ADMIN_OPERATOR_TOKEN=  # scoped tier for the operator/friend (no reboot/shutdown/terminal/panic)

# Console capture ring for #minilog / terminal / web logs
# DEV_CONSOLE_LOG_MAX=2000

# Temporal (RAM-only) message log shown in the dashboard Remote pane
# MSGLOG_CAP=250

# Dashboard stats sampling (sparklines + hourly BotKV aggregates)
# STATS_SAMPLE_MS=60000
# STATS_SAMPLE_MIN_MS=1000
# STATS_SERIES_MAX=720
# STATS_HOURLY_RETENTION_HOURS=168

# Fleet view — treat multiple mains as one dashboard ("all mains as one").
# Each main shows in its Overview how the OTHERS are doing. Format:
#   name:port:ADMIN_HTTP_TOKEN   (semicolon-separated, host = ADMIN_HTTP_HOST)
# Only list the OTHER instances; your own is added automatically as "you".
# FLEET_PEERS=home:9000:token1;work:9001:token2
# FLEET_TTL_MS=6000

# ------------------------------------------------------------------
# Remote-control watchdog (web dashboard operators)
# ------------------------------------------------------------------

# RC_MONITOR=on
# RC_FLAG_WARN=30
# RC_FLAG_LOCK=80
# RC_FLAG_WINDOW_MS=300000
# RC_FLAG_LOCKOUT_MS=600000
# RC_FLAG_RETENTION_DAYS=30

# ------------------------------------------------------------------
# Invite onboarding (self-service #pair via web page)
# ------------------------------------------------------------------

# INVITE_TTL_MS=86400000        # invite link lifetime (24 h)
# INVITE_MAX_USES=3             # links per person
# INVITE_MAX_IP_ATTEMPTS=3      # failed pairing attempts per IP
# INVITE_IP_WINDOW_MS=600000    # attempt window (10 min)

# ------------------------------------------------------------------
# ToS monitoring (Onyx Mini outbound + normal users inbound)
# ------------------------------------------------------------------

# MINI_MONITOR=on
# MINI_FLAG_WARN=30
# MINI_FLAG_SUSPEND=80
# MINI_FLAG_WINDOW_MS=300000
# MINI_FLAG_RETENTION_DAYS=30   # GDPR retention cap

# USER_MONITOR=on
# USER_FLAG_WARN=50
# USER_FLAG_BAN=120
# USER_FLAG_WINDOW_MS=300000
# USER_FLAG_RETENTION_DAYS=30

# Crashed update plugin (whitelist-access only)
# CRASHED_WHITELIST=
# CRASHED_AUDIO_NUKE=
# CRASHED_AUDIO_TAKE=
# CRASHED_AUDIO_SETCOM=
# CRASHED_AUDIO_SETLOG=
# CRASHED_AUDIO_GROUPINFO=

# ------------------------------------------------------------------
# Safety monitors (core panic + system watch)
# ------------------------------------------------------------------

# Core panic: 3-layer self-protection (in-process, external watchdog, hard kill).
# Disable entirely with CORE_PANIC=off / WATCHDOG=off.
# CORE_PANIC=on
# CORE_PANIC_EL_DELAY=2000        # event-loop delay ms
# CORE_PANIC_MEMORY_MB=900        # heap used MB
# CORE_PANIC_MSG_RATE=150         # inbound msgs/min
# CORE_PANIC_SEND_BURST=4         # outbound text burst limit
# CORE_PANIC_SEND_WINDOW_MS=2000  # burst look-back window
# CORE_PANIC_SUSTAINED=2          # consecutive over-limit checks before firing
# CORE_PANIC_GRACE_MS=600000      # 10 min grace after a panic
# CORE_PANIC_SETTLE_MS=60000      # skip checks for 1 min after boot
# CORE_PANIC_HB_DIR=              # heartbeat file dir (default: os tmp)
# WATCHDOG=on

# System watch: host health sampling (warn → log group, panic → core panic).
# SYSTEM_WATCH=on
# SYSTEM_WATCH_INTERVAL_MS=15000
# SYSTEM_WATCH_CPU_WARN=70        # bot process CPU %
# SYSTEM_WATCH_CPU_PANIC=160
# SYSTEM_WATCH_HOST_CPU_WARN=92   # host CPU is warn-only
# SYSTEM_WATCH_RAM_WARN=90
# SYSTEM_WATCH_RAM_PANIC=99
# SYSTEM_WATCH_DISK_WARN_MB=1024
# SYSTEM_WATCH_DISK_PANIC_MB=300
# SYSTEM_WATCH_RSS_WARN_MB=1000
# SYSTEM_WATCH_SUSTAINED=3
# SYSTEM_WATCH_COOLDOWN_MS=300000

# ------------------------------------------------------------------
# Logging & queue
# ------------------------------------------------------------------

LOG_LEVEL=warn
BAILEYS_LOG_LEVEL=silent

# Media job queue
JOB_CONCURRENCY=1
ERROR_ALERT_THRESHOLD=8

# Labels metrics / backups
TENANT_ID=default

# ------------------------------------------------------------------
# Search plugin (optional API keys)
# ------------------------------------------------------------------

# NEWS_API_KEY=            # required for #news
# NEWS_LANG=en
# WIKI_LANG=en